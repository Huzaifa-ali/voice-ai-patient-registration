# ---------------------------------------------------------------------------
# Voice AI Patient Registration — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# SQLAlchemy database URL. Default: a local SQLite file that persists to disk so
# data survives restarts and spans calls. Point at Postgres in production if desired
# (e.g. postgresql+psycopg://user:pass@host/db).
DATABASE_URL=sqlite:///./patients.db

# Shared secret for the Vapi webhook. Set the SAME value in your Vapi tool's server
# `secret` so we can reject spoofed requests. Leave blank to disable the check
# (fine for local dev; set it in production).
VAPI_WEBHOOK_SECRET=

# Server bind host/port. Render/Railway/Fly inject PORT automatically.
HOST=0.0.0.0
PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
